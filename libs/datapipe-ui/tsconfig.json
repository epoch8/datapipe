{
  "compilerOptions": {
    "target": "es5",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "module": "esnext",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "baseUrl": "src",
    "paths": {
      "@datapipe/ui/*": ["./*"],
      "@datapipe/ui-core": ["../../packages/ui-core/src/index.ts"],
      "@datapipe/ui-core/*": ["../../packages/ui-core/src/*"],
      "@datapipe/api-client": ["../../packages/api-client/src/index.ts"],
      "@datapipe/api-client/*": ["../../packages/api-client/src/*"]
    }
  },
  "include": [
    "src"
  ],
  "exclude": [
    "src/**/*.test.ts",
    "src/**/*.test.tsx"
  ]
}
